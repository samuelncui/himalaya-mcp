{
  "name": "himalaya-mcp",
  "version": "0.1.0",
  "description": "The original Himalaya email CLI as automatically generated MCP tools, with no user-side compilation.",
  "type": "module",
  "bin": {
    "himalaya-mcp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "examples/",
    "docs/"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelncui/himalaya-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/samuelncui/himalaya-mcp/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "generate": "node scripts/upstream.mjs generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "tsc -p tsconfig.test.json && node --test build/test/tests/*.test.js tests/*.test.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "verify:native": "node scripts/upstream.mjs verify",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "@types/node": "^24.0.0",
    "@types/tar": "^6.1.13",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tar": "7.5.22",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "2.9.1"
  }
}
